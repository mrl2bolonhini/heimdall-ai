    {
      "id": "guardar710",
      "name": "Guardar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        440
      ],
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nsd.fila = sd.fila || {};\nconst b = ($input.first().json.body && typeof $input.first().json.body === 'object') ? $input.first().json.body : $input.first().json;\nconst slot = String(b.slot || '').trim();\nconst titulo = String(b.titulo || '').replace(/\\s+/g, ' ').trim().slice(0, 80);\nconst linha = String(b.linha || '').replace(/\\r/g, '').trim();\nif (!slot || !titulo) return [{ json: { enviar: false, motivo: 'faltam slot e titulo' } }];\n// \"direto\" e urgente furam a fila e vão na hora\nif (slot === 'direto' || b.urgente === true) return [{ json: { enviar: true, titulo: titulo, corpo: linha.slice(0, 900), nivel: b.nivel === 'passive' ? 'passive' : 'active' } }];\nsd.fila[slot] = sd.fila[slot] || {};\nsd.fila[slot][titulo] = { linha: linha, em: Date.now() };\nreturn [{ json: { enviar: false, guardado: slot + ': ' + titulo } }];"
      }
    },
    {
