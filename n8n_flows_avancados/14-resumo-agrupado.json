  "nodes": [
    {
      "id": "s6h8he10h99",
      "name": "Às 6h, 8h e 10h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
