    },
    {
      "id": "montarresumo324",
      "name": "Montar resumo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nsd.fila = sd.fila || {};\nlet h = new Date().getHours();\ntry { if (typeof $now !== 'undefined' && $now) h = Number($now.toFormat('H')); } catch (e) {}\n// A agenda dispara às 6h, 8h e 10h; aceita pequeno atraso.\nconst slot = h < 7 ? 'manha1' : h < 9 ? 'manha2' : 'meio';\nconst rotulo = { manha1: '6h', manha2: '8h', meio: '10h' }[slot];\nconst fila = sd.fila[slot] || {};\nconst limite = Date.now() - 36 * 3600 * 1000;\nconst itens = Object.keys(fila).map(t => ({ titulo: t, linha: fila[t].linha, em: fila[t].em })).filter(x => x.em >= limite).sort((a, b) => a.em - b.em);\nsd.fila[slot] = {};\nif (!itens.length) return [];\nconst corpo = itens.map(x => {\n  const l = x.linha.split('\\n').map(y => y.trim()).filter(Boolean);\n  const primeiras = l.slice(0, 3).join(' ').slice(0, 260);\n  return x.titulo + ': ' + primeiras;\n}).join('\\n');\nreturn [{ json: { titulo: 'Resumo das ' + rotulo + ' (' + itens.length + ')', corpo: corpo.slice(0, 1800) } }];"
      }
    },
    {
      "id": "enviarresumo312",
      "name": "Enviar resumo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.day.app/push",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ device_key: '__BARK_KEY__', title: $json.titulo, body: String($json.corpo).slice(0, 900), group: 'heimdall' }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "executaragora387",
