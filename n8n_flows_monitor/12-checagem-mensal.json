      "name": "Montar lembrete",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "jsCode": "const itens = [\n  'Meu INSS (app ou meu.inss.gov.br): benefícios, pendências, mensagens e extrato',\n  'FGTS (app oficial): extrato e depósitos do empregador',\n  'Carteira de Trabalho Digital: contratos de trabalho e anotações novas',\n  'Registrato do Banco Central: contas, dívidas e chaves Pix em seu nome',\n  'Serasa ou SPC: pendências e consultas ao seu CPF'\n];\nreturn [{ json: { titulo: 'Checagem mensal dos serviços públicos', corpo: 'Abra os apps e sites oficiais por conta própria, sem usar links de mensagens: ' + itens.map((x, i) => (i + 1) + ') ' + x).join('; ') + '.' } }];"
      }
    },
    {
      "id": "enviaraoiphone496",
      "name": "Enviar ao iPhone",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.day.app/push",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ device_key: '__BARK_KEY__', title: $json.titulo, body: String($json.corpo).slice(0, 900), group: 'heimdall' }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "executaragora387",
