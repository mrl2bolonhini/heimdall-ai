{
  "id": "hdEstudoDiario01",
  "name": "Heimdall: pergunta de estudo dos livros",
  "active": false,
  "nodes": [
    {
      "id": "tododias20h664",
      "name": "Todo dia às 20h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 20
