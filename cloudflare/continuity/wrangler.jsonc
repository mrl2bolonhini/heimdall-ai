{
  // Heimdall Continuidade (fase 4 do guides/continuidade_nuvem.txt). NÃO implantar antes de: plano Workers Paid, política de gasto com bloqueio
  // em Workers e em Durable Objects, e cópias dos bancos no R2 (python3 heimdall_continuidade.py enviar). Implantação: scripts/continuidade_nuvem.sh.
  "name": "heimdall-continuidade",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "vars": {
    "CONTINUIDADE": "1",   // "0" desliga o failover e o Worker só repassa ao Mac
    "DORMIR_APOS_MS": "600000",
    "PAINEL": "controls.heimdall-ai.tech",   // com o Mac fora, este site mostra a página de controle da nuvem (exige Access)
    "FORA": "{\"chat.heimdall-ai.tech\":\"Chat\",\"lab.heimdall-ai.tech\":\"Lab\",\"flows.heimdall-ai.tech\":\"Painel de fluxos\"}",   // dependem do Mac: só mostram a página de fora do ar
    "ROTAS": "{\"finance.heimdall-ai.tech\":8016,\"health.heimdall-ai.tech\":8013,\"notes.heimdall-ai.tech\":8011,\"news.heimdall-ai.tech\":8012,\"learn.heimdall-ai.tech\":8019,\"games.heimdall-ai.tech\":8014,\"account.heimdall-ai.tech\":8018}"
  },
  // Sites do Heimdall que passam pelo Worker. Confira os nomes reais em heimdall urls antes de implantar.
  "routes": [
    { "pattern": "finance.heimdall-ai.tech/*", "zone_name": "heimdall-ai.tech" },
    { "pattern": "health.heimdall-ai.tech/*", "zone_name": "heimdall-ai.tech" },
    { "pattern": "notes.heimdall-ai.tech/*", "zone_name": "heimdall-ai.tech" },
    { "pattern": "news.heimdall-ai.tech/*", "zone_name": "heimdall-ai.tech" },
    { "pattern": "learn.heimdall-ai.tech/*", "zone_name": "heimdall-ai.tech" },
    { "pattern": "games.heimdall-ai.tech/*", "zone_name": "heimdall-ai.tech" },
    { "pattern": "account.heimdall-ai.tech/*", "zone_name": "heimdall-ai.tech" },
    { "pattern": "chat.heimdall-ai.tech/*", "zone_name": "heimdall-ai.tech" },
    { "pattern": "lab.heimdall-ai.tech/*", "zone_name": "heimdall-ai.tech" },
    { "pattern": "flows.heimdall-ai.tech/*", "zone_name": "heimdall-ai.tech" },
    { "pattern": "controls.heimdall-ai.tech/*", "zone_name": "heimdall-ai.tech" }
  ],
  "durable_objects": { "bindings": [{ "name": "CONTAINER", "class_name": "Continuidade" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Continuidade"] }],
  "containers": [
    {
      "class_name": "Continuidade",
      "scheduling_policy": "default",   // política estável: aceita instance_type e max_instances (a política durable_object ainda é beta e não aceita)
      "image": "./Dockerfile",
      "image_build_context": "../..",   // a raiz do repositório (o Dockerfile copia o código do Heimdall)
      "instance_type": "standard-1",
      "max_instances": 1               // uma instância só: teto de custo
    }
  ]
}
