  {
   "id": "segdecidir000010",
   "name": "Decidir aviso",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    620,
    200
   ],
   "parameters": {
    "jsCode": "// O agente já gravou a nota (se havia o que gravar). Aqui só se decide o aviso, sempre no grupo das 10h; só a gravidade alta fura a fila e entra na triagem.\nconst j = $input.first().json || {};\nif (j.ok !== true) throw new Error('A tarefa de segurança não terminou. ' + String(j.erro || 'sem resposta do agente').slice(0, 300));\nconst grav = String(j.gravidade || 'nenhuma');\nconst rotulo = { exposicao: 'Exposição do Mac', logs: 'Logs de segurança', commits: 'Commits' }[j.tarefa] || 'Segurança';\nif (grav === 'media' || grav === 'alta') {\n  const linha = String(j.linha || '').slice(0, 400);\n  return [{ json: { slot: 'meio', titulo: rotulo + (grav === 'alta' ? ' (alta)' : ' (média)'), linha: linha, urgente: grav === 'alta', grave: grav === 'alta',\n    triagem: { id: 'seguranca-' + String(j.tarefa) + '-' + new Date().toISOString().slice(0, 10), titulo: rotulo + ': ' + linha.slice(0, 100), resumo: linha, nivel: 'alto', fonte: 'seguranca' } } }];\n}\n// Sem aviso a dar. Se o dolphin falhou, o fluxo cai e o aviso de falha do Heimdall chega pelo Bark.\nif (j.modelo_erro) throw new Error('O dolphin não respondeu na tarefa ' + String(j.tarefa || '') + ': ' + String(j.modelo_erro).slice(0, 200));\nreturn [];"
   }
  },
  {
   "id": "segavisar0000011",
   "name": "Avisar",
   "type": "n8n-nodes-base.httpRequest",
